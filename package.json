{
  "name": "js-kit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "gate": "python tools/release_gate.py"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
