{
  "name": "@uppercut-labs/electron-control-channel",
  "version": "0.1.0",
  "description": "A control channel between scripts and a running Electron app over a named pipe or Unix socket, so a script never starts a second instance: launch classification, server and client.",
  "license": "MIT",
  "author": "Uppercut Labs <packages@uppercut-labs.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "keywords": [
    "electron",
    "ipc",
    "named-pipe",
    "unix-socket",
    "single-instance",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uppercut-labs/js-kit.git",
    "directory": "packages/electron-control-channel"
  },
  "bugs": {
    "url": "https://github.com/uppercut-labs/js-kit/issues"
  },
  "homepage": "https://github.com/uppercut-labs/js-kit/tree/main/packages/electron-control-channel#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
