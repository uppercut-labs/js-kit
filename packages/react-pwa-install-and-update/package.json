{
  "name": "@uppercut-labs/react-pwa-install-and-update",
  "version": "0.1.0",
  "description": "React hooks for PWAs: capture the install prompt, track standalone mode, register a service worker, and detect and apply updates.",
  "license": "MIT",
  "author": "Uppercut Labs <packages@uppercut-labs.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "keywords": [
    "react",
    "pwa",
    "service-worker",
    "beforeinstallprompt",
    "install",
    "update"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@testing-library/dom": "10.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uppercut-labs/js-kit.git",
    "directory": "packages/react-pwa-install-and-update"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
