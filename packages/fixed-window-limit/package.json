{
  "name": "@uppercut-labs/fixed-window-limit",
  "version": "1.0.0",
  "description": "Fixed-window attempt limiter with atomic reservation, fail-closed errors and pluggable counter stores: in-memory, Cloudflare D1 and Postgres.",
  "license": "MIT",
  "author": "Uppercut Labs <packages@uppercut-labs.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\""
