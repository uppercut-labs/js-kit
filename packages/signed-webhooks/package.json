{
  "name": "@uppercut-labs/signed-webhooks",
  "version": "0.1.0",
  "description": "Sign and verify webhooks with HMAC-SHA256: timestamped signatures, tolerance windows, constant-time checks, Stripe-Signature headers and delivery receipt dedupe. Web Crypto only.",
  "license": "MIT",
  "author": "Uppercut Labs <packages@uppercut-labs.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "keywords": [
    "webhook",
    "hmac",
    "signature",
    "stripe",
    "cloudflare-workers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uppercut-labs/js-kit.git",
    "directory": "packages/signed-webhooks"
  },
  "bugs": {
    "url": "https://github.com/uppercut-labs/js-kit/issues"
  },
  "homepage": "https://github.com/uppercut-labs/js-kit/tree/main/packages/signed-webhooks#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "sql.js": "1.17.0"
  }
}
